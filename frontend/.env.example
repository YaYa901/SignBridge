# Keep browser calls same-origin so HttpOnly + SameSite=Strict cookies and CSP work.
# Vite forwards /api and /media to this backend during development.
API_PROXY_TARGET=http://127.0.0.1:8000
# Do not set VITE_API_URL to a different site. For deployments, use a reverse proxy
# that serves the frontend, /api and /media from the same HTTPS origin.
VITE_API_URL=
