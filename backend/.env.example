# Copy to backend/.env for local development. Never commit real credentials.
ENV=development
DATABASE_PATH=./data/signbridge.db
SESSION_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Only behind a trusted proxy which replaces X-Forwarded-For, never appends untrusted values.
TRUST_PROXY=0
# Keep >=600000 in production. Lower settings are intended for automated tests only.
PASSWORD_ITERATIONS=600000

# In development only, an empty SMTP_HOST writes .eml files in data/dev-outbox.
# Production refuses email actions until SMTP_HOST, MAIL_FROM and https APP_URL are set.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
# Set both to 0 / 1 respectively only with a local test mailbox in development.
SMTP_STARTTLS=1
SMTP_DEMO=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Production SMTP uses STARTTLS and validates certificates. Port 587 is recommended.
# ADMIN_EMAILS is intentionally no longer supported. Verify an account, then:
# python grant_admin.py email@example.com
